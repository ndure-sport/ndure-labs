// Same app as labs/wrangler.jsonc, for when Cloudflare builds from the top of the repo.
// Keep the two files in sync (bindings, vars, crons).
{
  "$schema": "labs/node_modules/wrangler/config-schema.json",
  "name": "ndure-labs",
  "main": "labs/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "cd labs && npm ci --no-audit --no-fund && node client/build.mjs" },
  "assets": {
    "directory": "./labs/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/calendar/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ndure-labs-test",
      "database_id": "c5b27b7f-49ff-4b95-ac39-9e33f10b5634"
    }
  ],
  "triggers": { "crons": ["5 * * * *"] },
  "vars": {
    "APP_URL": "https://ndure-labs.arthur-2b2.workers.dev",
    "TEAM_EMAILS": "arthurherbosch@hotmail.com",
    "EMAIL_FROM_NAME": "NDURE Labs",
    "EMAIL_FROM_ADDRESS": "labs@ndure.dk",
    "CURRENCY": "eur"
  },
  "observability": { "enabled": true }
}
