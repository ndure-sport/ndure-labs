// Same app as labs/wrangler.jsonc, for when Cloudflare builds from the top of the repo.
// Keep the two files in sync (bindings, vars, crons).
{
  "$schema": "labs/node_modules/wrangler/config-schema.json",
  "name": "ndure-labs",
  "main": "labs/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "cd labs && npm ci --no-audit --no-fund && node client/build.mjs" },
  "assets": {
    "directory": "./labs/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/calendar/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ndure-labs-test",
      "database_id": "c5b27b7f-49ff-4b95-ac39-9e33f10b5634"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Per IP limits on the public forms (approximate, per Cloudflare location).
  "ratelimits": [
    { "name": "RL_CHECKOUT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "APP_URL": "https://ndure-labs.arthur-2b2.workers.dev",
    "TEAM_EMAILS": "arthurherbosch@hotmail.com",
    "EMAIL_FROM_NAME": "NDURE Labs",
    "EMAIL_FROM_ADDRESS": "labs@ndure.dk",
    // Public key of the Turnstile bot check. The check switches on once TURNSTILE_SECRET_KEY is set too.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFpeN7V8Vhq26NSw"
  },
  "observability": { "enabled": true },
  // Branch previews (Workers Builds runs `wrangler preview` for branches other than main).
  // Previews inherit nothing above, so they get their own empty database and no cron jobs.
  // Secrets for previews: npx wrangler preview base-config secret put STRIPE_SECRET_KEY (and the others).
  // APP_URL is left out on purpose: links then use the preview's own address.
  "previews": {
    "vars": {
      "TEAM_EMAILS": "arthurherbosch@hotmail.com",
      "EMAIL_FROM_NAME": "NDURE Labs (preview)",
      "EMAIL_FROM_ADDRESS": "labs@ndure.dk"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ndure-labs-preview",
        "database_id": "9eb8721f-bd17-482b-8531-de3813de5811"
      }
    ]
  }
}
