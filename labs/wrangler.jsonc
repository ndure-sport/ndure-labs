// Cloudflare setup for book.ndure.dk (test). Secrets are not in this file:
// add STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and BREVO_API_KEY in the dashboard
// under the Worker's Settings → Variables and Secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ndure-labs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node client/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/calendar/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ndure-labs-test",
      "database_id": "c5b27b7f-49ff-4b95-ac39-9e33f10b5634"
    }
  ],
  // Every 15 minutes: reminders, follow ups, retest nudges, staff summary, unpaid seats, alerts.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Per IP limits on the public forms (approximate, per Cloudflare location).
  "ratelimits": [
    { "name": "RL_CHECKOUT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "APP_URL": "https://ndure-labs.arthur-2b2.workers.dev",
    "TEAM_EMAILS": "arthurherbosch@hotmail.com",
    "EMAIL_FROM_NAME": "NDURE Labs",
    "EMAIL_FROM_ADDRESS": "labs@ndure.dk",
    "CURRENCY": "eur"
  },
  "observability": { "enabled": true }
}
