# Public URL of this app, no trailing slash. Used in Stripe return URLs and emails.
APP_URL=https://book.ndure.dk

# Stripe (start with test keys: sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase, EU region project. Service role key is server only, never expose it.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Cal.com
CALCOM_API_KEY=cal_live_xxx
CALCOM_WEBHOOK_SECRET=xxx
# One entry per Cal.com event type that riders can book. "seats" must match
# "Offer seats" on that event type in Cal.com. Example: morning holds 2, afternoon 1.
CALCOM_EVENT_TYPES=[{"id":1111111,"label":"Morning","seats":2},{"id":2222222,"label":"Afternoon","seats":1}]
# How many weeks ahead riders can book
BOOKING_WEEKS_AHEAD=6

# Airtable pricing table (optional; without it the defaults in src/lib/pricing.ts are used)
AIRTABLE_TOKEN=pat_xxx
AIRTABLE_BASE_ID=appxxx
AIRTABLE_PRICING_TABLE=Pricing

# Brevo transactional email
BREVO_API_KEY=xkeysib-xxx
EMAIL_FROM_NAME=NDURE Labs
EMAIL_FROM_ADDRESS=labs@ndure.dk

# Team admin page /admin (basic auth)
ADMIN_USER=ndure
ADMIN_PASSWORD=change-me
